[Unit]
Description=Now Playing bridge (Soloist events to the TV page)
After=soloist.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nowplaying
Group=nowplaying
# video: access to /dev/cec0 for turning the TV on.
SupplementaryGroups=video
EnvironmentFile=-/etc/soloist/soloist.conf
EnvironmentFile=/etc/nowplaying/nowplaying.conf
Environment=NOWPLAYING_WWW=/usr/local/share/nowplaying/www
ExecStart=/usr/bin/python3 -I /usr/local/libexec/nowplaying/bridge
CacheDirectory=nowplaying
CacheDirectoryMode=0700
Restart=on-failure
RestartSec=2

# Sandboxing. It needs loopback (Soloist, the TV page), outbound HTTPS for
# album art (the code only fetches from i.scdn.co) and /dev/cec0.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/cec0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
