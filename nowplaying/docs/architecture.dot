// Now Playing architecture. Regenerate the PNG with:
//   dot -Tpng -Gdpi=144 docs/architecture.dot -o docs/architecture.png
digraph nowplaying {
    rankdir=LR;
    bgcolor="white";
    pad=0.3;
    nodesep=0.5;
    ranksep=0.7;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
          fillcolor="#f4f4f4", color="#888888", margin="0.18,0.1"];
    edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];

    subgraph cluster_pi {
        label="Raspberry Pi"; labeljust=l; fontsize=12;
        style="rounded,dashed"; color="#aaaaaa";

        subgraph cluster_soloist {
            label="soloist/ (existing)"; fontsize=10;
            style="rounded,filled"; fillcolor="#eef6ee"; color="#9cc79c";
            soloist [label="soloist.service\n(user: soloist)"];
            proxy   [label="soloist-ws-proxy\n127.0.0.1:9090\nrejects Origin"];
        }

        subgraph cluster_np {
            label="nowplaying/ (new)"; fontsize=10;
            style="rounded,filled"; fillcolor="#eef2fb"; color="#9db0d9";
            bridge [label=<<b>nowplaying-bridge</b><br/>(user: nowplaying)<br/><font point-size="9">state machine · art pipeline · CEC<br/>HTTP + SSE on 127.0.0.1:9095</font>>,
                    fillcolor="#dfe8fa"];
            cache  [label="/var/cache/nowplaying\nart · thumb · bg · palette", shape=cylinder,
                    style=filled, fillcolor="#ffffff"];
            display [label=<<b>nowplaying-display</b><br/>(user: nowplaying-display, tty1)<br/><font point-size="9">Chromium in cage  |  WPE cog<br/>no /dev/snd · no network</font>>,
                     fillcolor="#dfe8fa"];
        }
    }

    cdn [label="i.scdn.co\n(album art CDN)", shape=ellipse, fillcolor="#ffffff"];
    tv  [label="TV", shape=box3d, fillcolor="#222222", fontcolor="white", color="#222222"];

    soloist -> proxy  [dir=back, label="internal\n:19090"];
    proxy   -> bridge [label="WebSocket events\n(get_state / get_queue only)"];
    bridge  -> cdn    [label="HTTPS GET\n(allow-listed host)"];
    bridge  -> cache  [dir=both, arrowsize=0.6];
    bridge  -> display [label="SSE state\n+ images\n(read-only)"];
    display -> tv     [label="HDMI video"];
    soloist -> tv     [label="HDMI audio\n(PipeWire)", style=dashed];
    bridge  -> tv     [label="CEC\nwake / standby", style=dotted, constraint=false];
}
